# =============================================================================
# Mali Youth Project — variables d'environnement
# Copiez ce fichier vers .env.local puis renseignez les valeurs.
# Ne committez JAMAIS .env.local.
# =============================================================================

# -----------------------------------------------------------------------------
# Marque (le nom final du produit peut changer)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_BRAND_NAME="Mali Youth Project"
NEXT_PUBLIC_BRAND_SHORT_NAME="MYP"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_CONTACT_EMAIL="contact@example.org"

# -----------------------------------------------------------------------------
# Couche de donnees
# `supabase` = production. `local` = magasin JSON de developpement (.data/).
# Si cette variable est absente, le driver est deduit :
#   Supabase configure -> supabase, sinon -> local.
# -----------------------------------------------------------------------------
DATA_DRIVER="local"
LOCAL_DATA_DIR=".data"

# -----------------------------------------------------------------------------
# Supabase (requis pour DATA_DRIVER=supabase)
# Tableau de bord Supabase > Project Settings > API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Cle de service : SERVEUR UNIQUEMENT. Ne jamais exposer au navigateur.
# Utilisee par les scripts de migration et de seed.
SUPABASE_SERVICE_ROLE_KEY=""
# Chaine de connexion Postgres directe (scripts/migrate.ts).
# Supabase > Project Settings > Database > Connection string > URI
SUPABASE_DB_URL=""

# -----------------------------------------------------------------------------
# Sessions du driver local (ignore quand DATA_DRIVER=supabase)
# Generez : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# -----------------------------------------------------------------------------
AUTH_SECRET=""

# -----------------------------------------------------------------------------
# Administration
# Liste d'adresses e-mail autorisees, separees par des virgules.
# -----------------------------------------------------------------------------
ADMIN_EMAILS=""

# -----------------------------------------------------------------------------
# IA (facultatif — l'application fonctionne entierement sans)
# AI_PROVIDER : mock | anthropic | none
# Toutes les cles restent cote serveur. Jamais de prefixe NEXT_PUBLIC_.
# -----------------------------------------------------------------------------
AI_PROVIDER="mock"
AI_API_KEY=""
AI_MODEL="claude-sonnet-4-5"
AI_BASE_URL=""
AI_TIMEOUT_MS="20000"
# Requetes IA autorisees par utilisateur et par heure.
AI_RATE_LIMIT_PER_HOUR="20"

# -----------------------------------------------------------------------------
# Analytique respectueuse de la vie privee (facultatif)
# NEXT_PUBLIC_ANALYTICS_PROVIDER : none | plausible
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ANALYTICS_PROVIDER="none"
NEXT_PUBLIC_ANALYTICS_DOMAIN=""
NEXT_PUBLIC_ANALYTICS_SCRIPT_URL=""
